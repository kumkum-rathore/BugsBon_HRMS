NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/hrms_system
ACCESS_TOKEN_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_TOKEN_PEPPER=replace-with-another-unique-random-secret-at-least-32-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Set these temporarily only when running the one-time bootstrap script.
# BOOTSTRAP_ADMIN_NAME=System Admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-12-chars-minimum
